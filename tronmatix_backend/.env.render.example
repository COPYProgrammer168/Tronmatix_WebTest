APP_NAME="Tronmatix Computer"
APP_ENV=production
APP_KEY=base64:D6uKctHfkODMxXt+gKJueJxV8LofX5LSTuxjWtYMbMA=
APP_DEBUG=false
APP_URL=https://tronmatix-backend.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Phnom_Penh
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging (Render captures stdout/stderr) ─────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── Database: SQLite on the persistent disk ─────────────────────────────────
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/data/database.sqlite
DB_FOREIGN_KEYS=true

# Avoid "database is locked" under concurrent Apache workers.
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

# ── Backups (same persistent disk, pruned automatically) ────────────────────
DB_BACKUP_PATH=/var/www/html/storage/data/backups
DB_BACKUP_KEEP_LAST=10

# Offsite copy on Cloudflare R2. Use a PRIVATE bucket (not the public
# product-images bucket) and reuse the AWS_* credentials below.
# The Docker entrypoint restores it automatically when the SQLite file is
# missing or empty, so data survives a lost/reset Render disk.
DB_BACKUP_DISK=s3_backup
DB_BACKUP_BUCKET=tronmatix-backups
DB_BACKUP_S3_PATH=database-backups
# Periodic offsite backup interval in seconds (0 disables). 900 = 15 minutes.
DB_BACKUP_INTERVAL_SECONDS=900

# ── Session / cache / queue / broadcast ─────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ── Object storage (Cloudflare R2 via the S3 driver) ────────────────────────
# Uploads must live outside the container or they disappear on redeploy.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=tronmatix-storage
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=https://efa9fc81ab145bae274144ca40776866.r2.cloudflarestorage.com
AWS_ENDPOINT_URL=https://efa9fc81ab145bae274144ca40776866.r2.cloudflarestorage.com
AWS_URL=https://pub-632ee21a5b7647bea10024cea36a8514.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Frontend / Sanctum ──────────────────────────────────────────────────────
FRONTEND_URL=https://tronmatix-frontend.onrender.com
SANCTUM_STATEFUL_DOMAINS=tronmatix-frontend.onrender.com

# ── Mail (Gmail SMTP used by the app) ───────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TronmatixComputer

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_BOT_TOKEN=
TELEGRAM_USER_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=https://tronmatix-frontend.onrender.com/
TELEGRAM_POLLER_ENABLED=true
VITE_TELEGRAM_BOT_USERNAME=tronmatix_notification_bot
VITE_TELEGRAM_BOT_ID=

# ── PayWay / ABA KHQR payment gateway ───────────────────────────────────────
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_RSA_PUBLIC_KEY=storage/payway_public.pem
PAYWAY_RSA_KEY_PATH=storage/payway_private.pem
PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments
KHQR_BAKONG_MERCHANT_NAME=TronmatixComputer
KHQR_BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
KHQR_STATIC_PAYWAY_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments
KHQR_BAKONG_TOKEN=

# ── Maps / AI ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_KEY=
GROQ_API_KEY=

# ── Firebase phone verification (public web config) ─────────────────────────
FIREBASE_API_KEY=AIzaSyCm_b7K1fCN9EbLJGb-kcIi53AtGIi2QCs
FIREBASE_AUTH_DOMAIN=tronmatixotp.firebaseapp.com
FIREBASE_PROJECT_ID=tronmatixotp
FIREBASE_STORAGE_BUCKET=tronmatixotp.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=49743803686
FIREBASE_APP_ID=1:49743803686:web:d50623f738839f5c6ebde7
FIREBASE_MEASUREMENT_ID=G-50BPGZ5E18
